let numbers = [11, 15, 16, 17, 20, 25, 27, 100];

for (let i = 0; i < numbers.length; i++) {

    if (numbers[i] % 2 === 0) {
        console.log(numbers[i] + " is Even");
    } 
    else {
        console.log(numbers[i] + " is Odd");
    }

}

output:
11 is Odd
15 is Odd
16 is Even
17 is Odd
20 is Even
25 is Odd
27 is Odd
100 is Even
