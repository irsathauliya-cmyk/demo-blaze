
<!DOCTYPE html>
<html>
<head>
    <title>EMart</title>

    <style>
        body {
            background-color: lightblue;
            text-align: center;
            font-family: Arial;
        }

        .login {
            background-color: white;
            width: 300px;
            margin: 100px auto;
            padding: 30px;
            border-radius: 10px;
        }

        h1 {
            color: brown;
        }

        input {
            padding: 10px;
            margin: 10px;
            width: 90%;
        }

        button {
            background-color: brown;
            color: white;
            padding: 10px 20px;
            border: none;
            margin: 10px;
            cursor: pointer;
        }

        footer {
            color: brown;
            font-size: 12px;
        }
    </style>
</head>

<body>

    <div class="login">

        <h1>EMart</h1>

        <input type="text" placeholder="Username">
        <br>

        <input type="password" placeholder="Password">
        <br>

        <button>Login</button>
        <br>

        <button>Forgot Password?</button>

    </div>

    <footer>
        © 2026 EMart Shopping
    </footer>

</body>
</html>
